# BesideBanq Environment Variables Template
# Copy this file to .env.local for local development, and add these keys in your Vercel Dashboard for production.

# ── Brevo API Settings ───────────────────────────────────────────────────────
# Get your API key from: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=xkeysib-your-brevo-api-key-here

# Sender details for automated emails (Subdomain recommended e.g. mail.besidebanq.com)
SENDER_EMAIL=welcome@mail.besidebanq.com
SENDER_NAME=BesideBanq

# Admin email to receive instant alerts when a client submits a request
ADMIN_NOTIFY_EMAIL=admin@besidebanq.com

# ── Google Sheets Webhook ────────────────────────────────────────────────────
# Google Apps Script Web App URL for real-time spreadsheet appending
GOOGLE_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID_HERE/exec
