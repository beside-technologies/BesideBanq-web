# Brevo API Key
BREVO_API_KEY=your_brevo_api_key_here

# Verified Sender Email & Name
# Note: Use your root authenticated domain address (e.g. welcome@besidebanq.com)
SENDER_EMAIL=welcome@mail.besidebanq.com
SENDER_NAME=BesideBanq

# Internal Admin Lead Alert Receiver
ADMIN_NOTIFY_EMAIL=support@besidebanq.com

# Google Sheets Apps Script Webhook URL
GOOGLE_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/your_script_id/exec
