# ==============================================================================
# BESIDEBANQ WEB (NEXT.JS) — VERCEL PRODUCTION ENVIRONMENT VARIABLES
# Add these in Vercel Project Settings -> Environment Variables
# ==============================================================================

# Core Backend API Route (Points to your Hetzner CX22 Caddy Endpoint)
NEXT_PUBLIC_API_URL=https://api.besidebanq.com
BACKEND_URL=https://api.besidebanq.com

# Waitlist Transactional Email Service (Resend)
RESEND_API_KEY=re_your_live_resend_api_key_here
SENDER_NAME=BesideBanq
SUPPORT_EMAIL=support@besidebanq.com

# Production Domain
NEXT_PUBLIC_SITE_URL=https://besidebanq.com
